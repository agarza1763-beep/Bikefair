# ---- Database ----
# PostgreSQL. A free instance from https://neon.com or https://supabase.com works fine.
# DATABASE_URL: the pooled connection the app uses at runtime (Supabase: transaction pooler,
# port 6543, with ?pgbouncer=true — Neon's default pooled string works as-is).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# DIRECT_URL: a non-transaction-pooled connection used only for `prisma db push`/`migrate`,
# which need session-level locks a transaction pooler doesn't support (Supabase: session pooler,
# port 5432; Neon: same URL as DATABASE_URL works, or its "direct connection" string).
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# ---- Auth (NextAuth v5) ----
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# ---- Seed / admin bootstrap ----
SEED_ADMIN_EMAIL="admin@bikefair.demo"
SEED_ADMIN_PASSWORD="Admin123!"

# ---- Object storage ----
# Local disk (public/uploads) is used automatically when nothing below is set — fine for local
# dev, but NOT for production: serverless hosts like Vercel don't have a persistent writable
# filesystem, so uploaded photos would vanish. In production, attach a Blob store to your Vercel
# project (Vercel dashboard -> Storage -> Create Database -> Blob) and it injects this
# automatically; for local testing against real Blob storage, copy the token from there.
# BLOB_READ_WRITE_TOKEN=""

# Alternative: point at S3-compatible storage instead of Vercel Blob (requires implementing
# S3StorageProvider in src/lib/storage.ts — currently a stub).
# STORAGE_PROVIDER="s3"
# S3_BUCKET=""
# S3_REGION=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_URL_BASE=""

# ---- Maps / geocoding (optional; falls back to a deterministic demo geocoder) ----
# MAPS_PROVIDER="google"
# GOOGLE_MAPS_API_KEY=""

# ---- Email (optional; falls back to console-logged "sent" emails in dev) ----
# EMAIL_PROVIDER="resend"
# RESEND_API_KEY=""
# EMAIL_FROM="BikeFair <no-reply@bikefair.demo>"

# ---- Brand ----
NEXT_PUBLIC_BRAND_NAME="BikeFair"
