# ---- Database ----
# PostgreSQL. A free instance from https://neon.com or https://supabase.com works fine.
# DATABASE_URL: the pooled connection the app uses at runtime (Supabase: transaction pooler,
# port 6543, with ?pgbouncer=true — Neon's default pooled string works as-is).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# DIRECT_URL: a non-transaction-pooled connection used only for `prisma db push`/`migrate`,
# which need session-level locks a transaction pooler doesn't support (Supabase: session pooler,
# port 5432; Neon: same URL as DATABASE_URL works, or its "direct connection" string).
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# ---- Auth (NextAuth v5) ----
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# ---- Seed / admin bootstrap ----
SEED_ADMIN_EMAIL="admin@bikefair.demo"
SEED_ADMIN_PASSWORD="Admin123!"

# ---- Object storage (required — no local-disk fallback) ----
# Photos upload directly from the browser to Vercel Blob (see src/app/api/blob/upload-photo).
# In production, attach a Blob store to your Vercel project (Vercel dashboard -> Storage ->
# Create Database -> Blob) and it injects this automatically. For local dev, copy the same
# token from there into this file — uploads won't work at all without it.
BLOB_READ_WRITE_TOKEN=""

# ---- Payments (Stripe) — required for real bike-shop membership billing ----
# From your Stripe dashboard: Developers -> API keys (Secret key) and Developers -> Webhooks
# (add an endpoint at /api/stripe/webhook listening for checkout.session.completed and
# customer.subscription.deleted, then copy its signing secret). Leave unset to keep the
# bike-shop signup flow in "request for review" mode with no real billing.
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""

# ---- Maps / geocoding (optional; falls back to a deterministic demo geocoder) ----
# MAPS_PROVIDER="google"
# GOOGLE_MAPS_API_KEY=""

# ---- Email — required for real sign-up verification and password reset emails to actually ----
# ---- reach users. Without this, those emails only print to the server console. ----
# Get an API key at https://resend.com (free tier: 100 emails/day). EMAIL_FROM must be a domain
# you've verified in Resend.
# EMAIL_PROVIDER="resend"
# RESEND_API_KEY=""
# EMAIL_FROM="BikeFair <no-reply@shopbikefair.com>"

# ---- Bot protection (optional; sign-up works without it, just less protected) ----
# Cloudflare Turnstile — free. From the Cloudflare dashboard: Turnstile -> Add a site, using the
# same domain already on your Cloudflare account. NEXT_PUBLIC_TURNSTILE_SITE_KEY is safe to expose
# to the browser; TURNSTILE_SECRET_KEY is not.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# TURNSTILE_SECRET_KEY=""

# ---- Brand ----
NEXT_PUBLIC_BRAND_NAME="BikeFair"
